# ============================================
# Taxi Badalona Aeropuerto - .gitignore
# ============================================

# --- Variables de entorno ---
.env
.env.local
.env.*.local
.env.development
.env.testing
.env.staging
.env.production

# --- Dependencias ---
node_modules/
bower_components/
vendor/

# --- Archivos de sistema ---
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# --- Editores e IDEs ---
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/
.classpath
*.sublime-project
*.sublime-workspace

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# --- Archivos temporales ---
tmp/
temp/
*.tmp
*.bak
*.orig

# --- Archivos de build ---
dist/
build/
*.min.js
*.min.css
*.map

# --- Herramientas de desarrollo ---
fix.ps1
fix_encoding.ps1

# --- Seguridad ---
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
