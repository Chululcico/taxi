# ============================================
# Taxi Badalona Aeropuerto - Variables de Entorno
# ============================================
# Copia este archivo como .env y rellena los valores.
# NUNCA subir .env a repositorios publicos.

# --- Entorno ---
# Modo de operacion: development | testing | production
NODE_ENV=production

# --- Dominio ---
# Dominio del sitio web (sin protocolo)
SITE_DOMAIN=taxibadalonaaeropuerto.com
# URL completa del sitio (con protocolo)
SITE_URL=https://taxibadalonaaeropuerto.com
# Protocolo utilizado
SITE_PROTOCOL=https

# --- Contacto del servicio de taxi ---
# Numero de telefono en formato internacional
TAXI_PHONE=+34628175162
# Numero de telefono para mostrar en la interfaz
TAXI_PHONE_DISPLAY=628 17 51 62
# Mensaje predefinido de WhatsApp (URL-encoded)
TAXI_WHATSAPP_MESSAGE=Hola%2C%20quiero%20reservar%20un%20taxi%20al%20aeropuerto

# --- Email de contacto ---
# Correo electronico del negocio
CONTACT_EMAIL=info@taxibadalonaaeropuerto.com

# --- Desarrollador ---
# Nombre completo del desarrollador web
DEV_NAME=Diego Alejandro Acosta Paramo
# Telefono del desarrollador (formato internacional)
DEV_PHONE=+34675370050
# Usuario de Instagram del desarrollador
DEV_INSTAGRAM=diegooaacosta
# NIF del desarrollador
DEV_NIF=47740831Y

# --- Direccion del negocio ---
# Nombre comercial
BUSINESS_NAME=Taxi Badalona Aeropuerto
# Direccion fisica
BUSINESS_ADDRESS=Calle Industria 75 1o 1a
# Codigo postal
BUSINESS_POSTAL=08914
# Ciudad
BUSINESS_CITY=Badalona
# Provincia
BUSINESS_PROVINCE=Barcelona
# Region (ISO 3166-2)
BUSINESS_REGION=ES-CT

# --- Google Maps ---
# Coordenadas de latitud
GOOGLE_MAPS_LAT=41.452759
# Coordenadas de longitud
GOOGLE_MAPS_LNG=2.2347481
# Place ID de Google Maps
GOOGLE_MAPS_PLACE_ID=0x12a4bb984b06af0b:0xebe8160a980629fc
# Nivel de zoom
GOOGLE_MAPS_ZOOM=19
# URL completa de Google Maps (con parametros de ubicacion)
GOOGLE_MAPS_URL=https://www.google.com/maps/place/taxi+badalona+aeropuerto/@41.452759,2.2347481,19z/data=!4m6!3m5!1s0x12a4bb984b06af0b:0xebe8160a980629fc!8m2!3d41.4526692!4d2.2347179!16s%2Fg%2F11tsz6122l?entry=ttu&amp;g_ep=EgoyMDI2MDcwOC4wIKXMDSoASAFQAw%3D%3D

# --- Logo e imagenes ---
# URL del logo/favicon
LOGO_URL=https://i.postimg.cc/C1b9L7d8/Chat-GPT-Image-9-jul-2026-01-01-41.png
# URL de la imagen principal del hero
HERO_IMAGE=https://i.postimg.cc/fbq2PQ6C/Chat-GPT-Image-9-jul-2026-13-55-12.png

# --- SEO ---
# Titulo principal del sitio
SEO_TITLE=Taxi Badalona Aeropuerto
# Meta descripcion del sitio
SEO_DESCRIPTION=Taxi oficial AMB desde hace mas de 18 anos. Traslados al aeropuerto de Barcelona desde Badalona.
# Palabras clave principales
SEO_KEYWORDS=taxi badalona aeropuerto, traslados aeropuerto barcelona, transfer privado, taxi 24 horas, taxi 7 plazas, taxi precio fijo

# --- Seguridad ---
# Maximo de peticiones por ventana de tiempo (rate limiting)
RATE_LIMIT_REQUESTS=60
# Ventana de tiempo para rate limiting en milisegundos (60000 = 1 minuto)
RATE_LIMIT_WINDOW=60000
# Origen permitido para CORS (para futuras APIs)
CORS_ORIGIN=https://taxibadalonaaeropuerto.com
# URI de reporte CSP (opcional, para monitoreo de violaciones de CSP)
CSP_REPORT_URI=
# Tiempo maximo de HSTS en segundos (31536000 = 1 ano)
HSTS_MAX_AGE=31536000
