# ============================================
# Taxi Badalona Aeropuerto - .htaccess
# Seguridad, Headers, Cache, CORS, Rate Limiting
# ============================================

# --- Activar motor rewrite ---
<IfModule mod_rewrite.c>
    RewriteEngine On
</IfModule>

# ============================================
# 1. CABECERAS DE SEGURIDAD
# ============================================

# Prevenir clickjacking
<IfModule mod_headers.c>
    Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Prevenir MIME-type sniffing
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>

# Habilitar XSS Protection del navegador
<IfModule mod_headers.c>
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

# Politica de referrer
<IfModule mod_headers.c>
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Politica de permisos
<IfModule mod_headers.c>
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=(self), interest-cohort=(), browsing-topics=()"
</IfModule>

# HTTP Strict Transport Security (HSTS)
<IfModule mod_headers.c>
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# Content Security Policy
<IfModule mod_headers.c>
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' https://i.postimg.cc data: https://maps.google.com https://maps.googleapis.com; connect-src 'self' https://wa.me; frame-src https://www.google.com https://maps.google.com; base-uri 'self'; form-action 'self'"
</IfModule>

# ============================================
# 2. PROTECCION CONTRA ATAQUES
# ============================================

# Bloquear intentos de acceso a archivos sensibles
<IfModule mod_rewrite.c>
    # Bloquear acceso a archivos .env
    RewriteRule ^\.env$ - [F,L]
    
    # Bloquear acceso a archivos .git
    RewriteRule ^\.git - [F,L]
    
    # Bloquear acceso a archivos .htaccess
    RewriteRule ^\.htaccess$ - [F,L]
    
    # Bloquear acceso a archivos de backup
    RewriteRule \.(bak|config|sql|log|ini|old|orig|tmp)$ - [F,L]
    
    # Bloquear acceso a archivos de sistema
    RewriteRule ^\.(DS_Store|Thumbs.db|Desktop.ini)$ - [F,L]
</IfModule>

# Bloquear directorios sin index
Options -Indexes

# ============================================
# 3. RATE LIMITING (Basic)
# ============================================

<IfModule mod_ratelimit.c>
    <IfModule mod_headers.c>
        Header set X-RateLimit-Limit "60"
        Header set X-RateLimit-Remaining "59"
    </IfModule>
</IfModule>

# Bloquear IPs con太多 peticiones (configurable via .env en deploy)
# <IfModule mod_rewrite.c>
#     RewriteCond %{REMOTE_ADDR} ^xx\.xx\.xx\.xx$
#     RewriteRule .* - [F,L]
# </IfModule>

# ============================================
# 4. CORS (para futuras APIs)
# ============================================

<IfModule mod_headers.c>
    # Permitir solo origen especificado
    Header set Access-Control-Allow-Origin "https://taxibadalonaaeropuerto.com"
    Header set Access-Control-Allow-Methods "GET, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization"
    Header set Access-Control-Max-Age "86400"
    
    # Ocultar información del servidor
    Header unset Server
    Header unset X-Powered-By
</IfModule>

# ============================================
# 5. CACHE Y RENDIMIENTO
# ============================================

# Cache de archivos estaticos
<IfModule mod_expires.c>
    ExpiresActive On
    
    # HTML - no cachear (contenido dinamico)
    ExpiresByType text/html "access plus 0 seconds"
    
    # CSS - cachear 1 ano
    ExpiresByType text/css "access plus 1 year"
    
    # JavaScript - cachear 1 ano
    ExpiresByType application/javascript "access plus 1 year"
    
    # Imagenes - cachear 1 ano
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    
    # Fuentes - cachear 1 ano
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    
    # JSON (schema.org) - cachear 1 semana
    ExpiresByType application/json "access plus 1 week"
</IfModule>

# Compresion GZIP
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# ============================================
# 6. PROTECCION DE IMAGENES (Anti-Hotlink)
# ============================================

<IfModule mod_rewrite.c>
    # Bloquear hotlinking de imagenes
    RewriteCond %{HTTP_REFERER} !^$
    RewriteCond %{HTTP_REFERER} !^https://(www\.)?taxibadalonaaeropuerto\.com [NC]
    RewriteCond %{HTTP_REFERER} !^https://(www\.)?google\.com [NC]
    RewriteCond %{HTTP_REFERER} !^https://(www\.)?bing\.com [NC]
    RewriteCond %{HTTP_REFERER} !^https://(www\.)?facebook\.com [NC]
    RewriteCond %{HTTP_REFERER} !^https://(www\.)?twitter\.com [NC]
    RewriteCond %{HTTP_REFERER} !^https://(www\.)?instagram\.com [NC]
    RewriteCond %{HTTP_REFERER} !^https://(www\.)?linkedin\.com [NC]
    RewriteCond %{HTTP_REFERER} !^https://(www\.)?pinterest\.com [NC]
    RewriteCond %{HTTP_REFERER} !^https://(www\.)?t\.co [NC]
    RewriteCond %{HTTP_REFERER} !^https://(www\.)?wa\.me [NC]
    RewriteCond %{HTTP_REFERER} !^https://(www\.)?telegram\.org [NC]
    RewriteCond %{HTTP_REFERER} !^https://(www\.)?t\.me [NC]
    RewriteCond %{HTTP_REFERER} !^https://(www\.)?reddit\.com [NC]
    RewriteCond %{HTTP_REFERER} !^https://(www\.)?tiktok\.com [NC]
    RewriteCond %{HTTP_REFERER} !^https://(www\.)?youtube\.com [NC]
    RewriteCond %{HTTP_REFERER} !^https://(www\.)?postimg\.cc [NC]
    RewriteRule \.(jpg|jpeg|png|gif|webp|svg|ico)$ - [F,NC,L]
</IfModule>

# ============================================
# 7. PROTECCION DE ARCHIVOS SENSIBLES
# ============================================

# Bloquear acceso a archivos de configuracion
<FilesMatch "\.(env|git|htaccess|htpasswd|ini|log|bak|sql|conf|config)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Bloquear acceso a scripts de PowerShell
<FilesMatch "\.(ps1|psm1|psd1)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Bloquear acceso a archivos de sistema
<FilesMatch "^(Thumbs\.db|Desktop\.ini|\.DS_Store)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# ============================================
# 8. MIME TYPES
# ============================================

<IfModule mod_mime.c>
    AddType text/css .css
    AddType application/javascript .js
    AddType image/jpeg .jpeg
    AddType image/png .png
    AddType image/gif .gif
    AddType image/webp .webp
    AddType image/svg+xml .svg
    AddType image/x-icon .ico
    AddType font/woff .woff
    AddType font/woff2 .woff2
    AddType font/ttf .ttf
    AddType font/otf .otf
    AddType application/json .json
    AddType application/xml .xml
    AddType text/xml .xml
</IfModule>

# ============================================
# 9. CUSTOM ERROR PAGES
# ============================================

ErrorDocument 403 /index.html
ErrorDocument 404 /index.html
ErrorDocument 500 /index.html
